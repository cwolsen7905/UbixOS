# (C) 2002-2026 The uBixOS Project
# libcss — NetSurf CSS parser + selection engine (vendored, MIT).
#
# The 119 per-property parsers (autogenerated_*.c) and the select
# autogenerated_*.h were produced on the build host (gen_parser /
# select_generator) and vendored, so no codegen runs in the uBixOS build.
# Sources span many subdirs with COLLIDING basenames (e.g. utils.c in two
# dirs), so each .c compiles to a path-mangled unique object via a .for loop
# rather than a flat .PATH suffix rule.

include ../../Makefile.incl
include ../Makefile.incl

MUSL_SRC = ${SRCTOP}/contrib/musl
MUSL_OBJ = ${OBJ_DIR}/obj/musl
CSS      = ${SRCTOP}/contrib/libcss
LPU      = ${SRCTOP}/contrib/libparserutils
LWC      = ${SRCTOP}/contrib/libwapcaplet

# Per-arch knobs (NetSurf C libs): i386 disables x86 SIMD + links elf_i386;
# aarch64 uses its musl arch headers + the aarch64 ld emulation, no SSE flags.
.if ${_ARCH} == "aarch64"
ARCH_SIMD     =
ARCH_MUSL_INC = -I${MUSL_SRC}/arch/aarch64
ARCH_LDEMUL   = aarch64elf
.else
ARCH_SIMD     = -mno-sse -mno-sse2 -mno-mmx -mno-3dnow
ARCH_MUSL_INC = -I${MUSL_SRC}/arch/i386
ARCH_LDEMUL   = elf_i386
.endif

INCLUDES = -I${CSS}/include -I${CSS}/src \
           -I${LPU}/include -I${LWC}/include \
           -I${MUSL_SRC}/include \
           -I${MUSL_OBJ}/obj/include \
           ${ARCH_MUSL_INC} \
           -I${MUSL_SRC}/arch/generic

# -fcommon: libcss has a tentative global (_ALIGNED) in a shared header that
# modern GCC's default -fno-common would reject as a multiple definition.
CFLAGS = ${CROSS_M32} -nostdinc -fno-builtin -fPIC -fcommon \
         ${ARCH_SIMD} -MMD -MP \
         -Wall -O2

OBJDIR = ${OBJ_DIR}/obj/lib/libcss

# Every .c under src/ except the host-only generator tool.  Paths are relative
# to src/ (e.g. parse/properties/azimuth.c).
SRCS != cd ${CSS}/src && find . -name '*.c' ! -name 'css_property_parser_gen.c' | sed 's|^\./||' | sort
# Unique object names: parse/properties/azimuth.c -> parse_properties_azimuth.o
OBJS = ${SRCS:S|/|_|g:.c=.o}

all: ${OBJ_DIR}/lib/libcss.so

# One compile rule per source (basenames collide, so no suffix rule).
.for s in ${SRCS}
${OBJDIR}/${s:S|/|_|g:.c=.o}: ${CSS}/src/${s}
	@mkdir -p ${OBJDIR}
	$(CC) $(CFLAGS) $(INCLUDES) -MT ${.TARGET} -MF ${.TARGET:.o=.d} -c -o ${.TARGET} ${.ALLSRC:M*.c}
.endfor

# Links libparserutils.so + libwapcaplet.so (resolved from /lib at load).
${OBJ_DIR}/lib/libcss.so: ${OBJS:S|^|${OBJDIR}/|}
	@mkdir -p ${OBJ_DIR}/lib
	$(LD) -m ${ARCH_LDEMUL} -shared -soname libcss.so \
		${OBJS:S|^|${OBJDIR}/|} \
		-L${OBJ_DIR}/lib -lparserutils -lwapcaplet -lc \
		-o ${OBJ_DIR}/lib/libcss.so

clean:
	$(REMOVE) ${OBJDIR} ${OBJ_DIR}/lib/libcss.so

.for _d in ${OBJS:.o=.d}
.sinclude "${OBJDIR}/${_d}"
.endfor
