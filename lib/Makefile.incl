# (C) 2002-2026 The UbixOS Project
# 'lib' options

.include "${UBIX_MK}/ubix.platform.mk"
.include "${UBIX_MK}/ubix.toolchain.mk"

CC=${UBIX_CC}
CXX=${UBIX_CXX}
AS=${UBIX_AS}
AR=${UBIX_AR}
LD=${UBIX_LD}
NM=${UBIX_NM}
OBJCOPY=${UBIX_OBJCOPY}
RANLIB=${UBIX_RANLIB}

LDFLAGS = -Bshareable

MUSL_SRC = ${SRCTOP}/contrib/musl
MUSL_OBJ = ${OBJ_DIR}/obj/musl
INCLUDES = -I${MUSL_SRC}/include \
           -I${MUSL_OBJ}/obj/include \
           -I${MUSL_SRC}/arch/${MUSL_ARCH} \
           -I${MUSL_SRC}/arch/generic \
           -I${SRCTOP}/include
CFLAGS = ${CROSS_M32} ${WFLAGS} -Wall -nostdlib -nostdinc -fno-builtin -fno-exceptions -fno-rtti -O \
         ${ARCH_NOSIMD} -fPIC -MMD -MP
