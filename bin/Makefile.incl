# (C) 2002-2026 The UbixOS Project
# 'bin' options

.include "${UBIX_MK}/ubix.platform.mk"

# CC/CXX/AS/AR/LD/NM/OBJCOPY/RANLIB + TC_NOSTDINC/TC_STDFLAG come from
# ubix.toolchain.mk (set + exported by Makefile.incl, which every subdir Makefile
# includes first).  TC_NOSTDINC is -nostdinc (gcc) / -nostdlibinc (clang);
# TC_STDFLAG pins -std=gnu23 under clang.

BUILD_DIR?=${SRCTOP}/build

CFLAGS = ${CROSS_M32} -nostdlib ${TC_NOSTDINC} ${TC_STDFLAG} -fno-builtin -fno-exceptions -fno-rtti \
         -Wno-unused-command-line-argument \
         ${ARCH_NOSIMD} -MMD -MP
LDFLAGS = -Wl,-m,${MUSL_LDEMULATION}

MUSL_SRC = ${SRCTOP}/contrib/musl
MUSL_OBJ = ${OBJ_DIR}/obj/musl
INCLUDES = -I${MUSL_SRC}/include \
           -I${MUSL_OBJ}/obj/include \
           -I${MUSL_SRC}/arch/${MUSL_ARCH} \
           -I${MUSL_SRC}/arch/generic \
           -I${SRCTOP}/include

LIBRARIES = ${OBJ_DIR}/obj/lib/*/*.o \
            ${OBJ_DIR}/obj/ubix_api/ubixcwd.o \
            ${OBJ_DIR}/obj/ubix_api/ttyctrl.o

STARTUP = ../../lib/ubix/*.o
