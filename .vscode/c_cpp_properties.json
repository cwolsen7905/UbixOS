{
    "configurations": [
        {
            "name": "Kernel (i386 bare-metal)",
            "compileCommands": "${workspaceFolder}/compile_commands.json",
            "includePath": [
                "${workspaceFolder}/sys/include/**"
            ],
            "defines": [
                "__i386__",
                "DEBUG_SYSCTL",
                "KERNEL"
            ],
            "compilerPath": "/opt/homebrew/bin/x86_64-elf-gcc",
            "compilerArgs": [
                "-m32",
                "-ffreestanding",
                "-fno-builtin",
                "-fno-pie",
                "-fno-pic"
            ],
            "cStandard": "gnu11",
            "cppStandard": "gnu++20",
            "intelliSenseMode": "gcc-x86",
            "browse": {
                "path": [
                    "${workspaceFolder}/sys"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        },
        {
            "name": "World (userland)",
            "compileCommands": "${workspaceFolder}/compile_commands.json",
            "includePath": [
                "${workspaceFolder}/include/**",
                "${workspaceFolder}/contrib/musl/include",
                "${workspaceFolder}/contrib/musl/arch/i386",
                "${workspaceFolder}/contrib/musl/arch/generic",
                "${workspaceFolder}/contrib/libcxx/include",
                "${workspaceFolder}/contrib/libcxxabi/include"
            ],
            "defines": [
                "__i386__",
                "__UBIXOS__"
            ],
            "compilerPath": "/opt/homebrew/bin/x86_64-elf-gcc",
            "compilerArgs": [
                "-m32",
                "-ffreestanding"
            ],
            "cStandard": "gnu11",
            "cppStandard": "gnu++20",
            "intelliSenseMode": "gcc-x86",
            "browse": {
                "path": [
                    "${workspaceFolder}/bin",
                    "${workspaceFolder}/lib",
                    "${workspaceFolder}/include"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}
