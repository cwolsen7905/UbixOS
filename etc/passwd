# uBixOS /etc/passwd — identity (uid/gid/home/shell) for getpwnam().
#
# STOPGAP: hand-maintained to unblock the Dropbear sshd port.  Slated to become
# a DERIVED projection that authd regenerates from its authoritative
# /etc/userdb on init + on user add/remove/modify — see
# docs/design/multiuser-security-plan.md Phase 1b.  Not a second source of truth.
#
# Password verification is delegated to authd (/etc/userdb, PBKDF2); the
# 'x' placeholder here means "see the shadow authority" — never a hash.
root:x:0:0:root:/home/root:/bin/tcsh
guest:x:1:1:guest:/home/guest:/bin/tcsh
reddawg:x:1000:0:reddawg:/home/reddawg:/bin/tcsh
bsd:x:0:0:bsd:/home/bsd:/bin/tcsh
