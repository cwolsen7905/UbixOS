# UbixOS terminal configuration — read by ttyd at startup.
#
# Fields (whitespace-delimited):
#   name      terminal name
#   program   full VFS path of the program to exec
#   status    on | off
#
# Virtual VGA consoles: ttyv0 .. ttyv3  (slots 0-3, Alt-F1 through Alt-F4)
# Serial consoles:      com1            (slot 4, COM1 RS-232)
#
# Alt+F1 always shows ttyv0.  Enable ttyv1-ttyv3 below to get additional
# VGA virtual consoles.  Switch with Alt+F1 through Alt+F4.
#
# To switch ttyv0 to the graphical compositor instead of login:
#   ttyv0   sys:/bin/vlogin   on
#
ttyv0   sys:/bin/login   on
ttyv1   sys:/bin/login   on
ttyv2   sys:/bin/login   on
ttyv3   sys:/bin/login   on
com1    sys:/bin/login   on
