# /etc/fstab - UbixOS static mount table
#
# device       mountpoint   fstype    options
none           /dev         devfs     defaults
none           /proc        procfs    defaults
# The FAT boot partition (kernel + GRUB) mounted into the running tree.  Must
# come after /dev so the kernel can resolve /dev/ad0s1 -> (major, minor).  Only
# acted on where automountd runs (i386); harmless elsewhere.
/dev/ad0s1     /boot        fat       rw
