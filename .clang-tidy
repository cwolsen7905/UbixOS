# uBixOS clang-tidy configuration.
#
# Naming rules come from STYLE.md; the bug/safety profile from
# docs/standards/coding.md (SEI CERT C subset + bugprone + analyzer).
#
# Run via tools/mcr.sh [file...] or tools/check/run.sh clang-tidy.  The gate
# applies findings on lines a change added only, so the legacy tree does not
# block; naming checks stay warnings during migration.  Do not add `-Wno-*`
# style suppressions here to quieten new code — fix the code.
#
# Rationale for the exclusions below:
#   bugprone-easily-swappable-parameters  noise on every (ptr, len) API
#   bugprone-reserved-identifier,
#   cert-dcl37-c, cert-dcl51-cpp           kernel/libc must define __ names
#   bugprone-assignment-in-if-condition    idiomatic style(9) (`if ((error = f()))`)
#   cert-err33-c                           flags every ignored printf/memset result
#   cert-msc32-c, cert-msc51-cpp           PRNG seeding: not a kernel concern
#   clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling
#                                          covered by the banned-api gate instead
#   clang-analyzer-optin.performance.Padding  structs are ABI-fixed, not tuned

Checks: >
  readability-identifier-naming,
  readability-misleading-indentation,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  -bugprone-assignment-in-if-condition,
  cert-*,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  -cert-err33-c,
  -cert-msc32-c,
  -cert-msc51-cpp,
  clang-analyzer-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -clang-analyzer-optin.performance.Padding,
  misc-redundant-expression,
  misc-use-internal-linkage,
  misc-unused-parameters,
  misc-static-assert,
  -clang-diagnostic-*

# Findings are surfaced as warnings; the gate decides what blocks (added lines).
WarningsAsErrors: ''

# First-party headers only, matched against the include path as written
# (tools/check passes relative -Isys/include).  Keeps contrib/ and the host
# SDK out of the report.
HeaderFilterRegex: '^(sys|include|lib|bin|sbin|usr\.bin|usr\.sbin|libexec|tests)/'

CheckOptions:

  # ── Functions ────────────────────────────────────────────────────────────────
  # Kernel and userland functions: snake_case (prefix handled by convention,
  # not enforced here — clang-tidy can't express "prefix_snake_case" directly)
  - key:   readability-identifier-naming.FunctionCase
    value: lower_case

  # ── Variables ────────────────────────────────────────────────────────────────
  - key:   readability-identifier-naming.LocalVariableCase
    value: lower_case

  - key:   readability-identifier-naming.ParameterCase
    value: lower_case

  # Global variables: g_ prefix + snake_case
  - key:   readability-identifier-naming.GlobalVariableCase
    value: lower_case
  - key:   readability-identifier-naming.GlobalVariablePrefix
    value: g_

  # Static file-scope variables: g_ prefix + snake_case
  - key:   readability-identifier-naming.StaticVariableCase
    value: lower_case
  - key:   readability-identifier-naming.StaticVariablePrefix
    value: g_

  # ── Types ────────────────────────────────────────────────────────────────────
  # Struct tags: snake_case
  - key:   readability-identifier-naming.StructCase
    value: lower_case

  # Typedefs: snake_case with _t suffix
  - key:   readability-identifier-naming.TypedefCase
    value: lower_case
  - key:   readability-identifier-naming.TypedefSuffix
    value: _t

  # Enum type names: snake_case with _t suffix
  - key:   readability-identifier-naming.EnumCase
    value: lower_case
  - key:   readability-identifier-naming.EnumSuffix
    value: _t

  # Enum values: ALL_CAPS
  - key:   readability-identifier-naming.EnumConstantCase
    value: UPPER_CASE

  # ── Macros ───────────────────────────────────────────────────────────────────
  - key:   readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
