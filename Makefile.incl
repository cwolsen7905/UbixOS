# The System Makefile (C) 2002, 2017 The UbixOS Project
# Global 'Source' Options

#Global Override And Defs
_ARCH=i386

REMOVE = rm -rf

FD_DEVICE = /dev/md0

# Cross-compiler prefix.
# Homebrew provides x86_64-elf-gcc (not i386-elf-gcc); we use it with -m32
# to target i386.  On FreeBSD native the prefix is empty (host toolchain).
UNAME_S != uname -s
.if ${UNAME_S} == "Darwin"
CROSS_PREFIX?=x86_64-elf-
CROSS_M32?=-m32
.else
CROSS_PREFIX?=
CROSS_M32?=
.endif
