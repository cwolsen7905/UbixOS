# The System Makefile (C) 2002-2026 The UbixOS Project
# Global 'Source' Options

# Target architecture.  TARGET_ARCH is the user-facing knob; _ARCH is the
# historical alias the kernel tree keys off (sys/arch/${_ARCH},
# ldscript.${_ARCH}, obj/sys/${_ARCH}).  The matching
# share/mk/ubix.target.${_ARCH}.mk supplies the per-arch toolchain + ISA/ABI
# compile flags and linker-script suffix, keeping arch facts out of the shared
# host-detection and CFLAGS.
#
# Override with either spelling: `bmake TARGET=aarch64` (short alias, resolved
# first) or `bmake TARGET_ARCH=aarch64`.
#
# NOTE: the default is intentionally still i386 — flip it to aarch64 only once
# the aarch64 kernel actually builds/boots (otherwise a bare `bmake` would error
# on the not-yet-existent arch tree).  Until then aarch64 is driven by the
# override and the i386 build/run path is unchanged.
.if defined(TARGET) && !empty(TARGET)
TARGET_ARCH ?= ${TARGET}
.endif
TARGET_ARCH ?= i386
_ARCH       ?= ${TARGET_ARCH}

REMOVE = rm -rf

FD_DEVICE = /dev/md0

# Compute the repo root once via git; derive UBIX_MK and OBJ_DIR from it.
# The .if !defined guard means child makes inherit these via the environment
# and skip the git call entirely.
.if !defined(SRCTOP)
SRCTOP != cd "${.CURDIR}" && git rev-parse --show-toplevel 2>/dev/null | tr -d '\n'
.if empty(SRCTOP)
SRCTOP = ${.CURDIR}
.endif
.export SRCTOP
.endif
UBIX_MK ?= ${SRCTOP}/share/mk
.export UBIX_MK
OBJ_DIR ?= ${SRCTOP}/build
.export OBJ_DIR

.include "${UBIX_MK}/ubix.platform.mk"
.include "${UBIX_MK}/ubix.target.${_ARCH}.mk"
