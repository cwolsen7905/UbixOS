# The System Makefile (C) 2002-2026 The UbixOS Project
# Global 'Source' Options

_ARCH?=i386

REMOVE = rm -rf

FD_DEVICE = /dev/md0

# Compute the repo root once via git; derive UBIX_MK and OBJ_DIR from it.
# The .if !defined guard means child makes inherit these via the environment
# and skip the git call entirely.
.if !defined(SRCTOP)
SRCTOP != cd "${.CURDIR}" && git rev-parse --show-toplevel 2>/dev/null | tr -d '\n'
.if empty(SRCTOP)
SRCTOP = ${.CURDIR}
.endif
.export SRCTOP
.endif
UBIX_MK ?= ${SRCTOP}/share/mk
.export UBIX_MK
OBJ_DIR ?= ${SRCTOP}/build
.export OBJ_DIR

.include "${UBIX_MK}/ubix.platform.mk"
