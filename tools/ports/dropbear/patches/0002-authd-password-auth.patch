 #include "auth.h"
 #include "runopts.h"
 
+/* uBixOS: password verification is owned by authd (see include/authd.h), the
+ * only process that reads the credential store (/etc/userdb, PBKDF2-SHA256).
+ * We talk to it over MPI exactly like login(1) does — musl's crypt() can't read
+ * authd's passlib-format hashes, so the crypt path below is bypassed. */
+#include <sys/mpi.h>
+#include <authd.h>
+#include <sched.h>
+
 #if DROPBEAR_SVR_PASSWORD_AUTH
 
+/**
+ * Verify a username/password pair against authd over MPI.
+ *
+ * Mirrors login(1)'s do_auth(): post an AUTH_REQUEST to the "authd" mailbox and
+ * block for the AUTH_RESPONSE on a private reply mailbox.  authd runs PBKDF2
+ * (tens of ms), so we wait properly rather than spin.
+ *
+ * @return 1 if authenticated, 0 otherwise (including authd unreachable).
+ */
+static int ubixos_authd_verify(const char *username, const char *password) {
+	mpi_message_t msg, rmsg;
+	struct auth_request req;
+	struct auth_response resp;
+	char reply_mbox[AUTH_MBOX_MAX];
+	int waited;
+
+	snprintf(reply_mbox, sizeof(reply_mbox), "sshd.auth.%d", (int)getpid());
+	if (mpi_createMbox(reply_mbox) != 0)
+		return 0;
+
+	memset(&req, 0, sizeof(req));
+	strncpy(req.reply_mbox, reply_mbox, AUTH_MBOX_MAX - 1);
+	strncpy(req.username, username, AUTH_USER_MAX - 1);
+	strncpy(req.password, password, AUTH_PASS_MAX - 1);
+
+	memset(&msg, 0, sizeof(msg));
+	msg.header = AUTHD_MSG_REQUEST;
+	memcpy(msg.data, &req, sizeof(req));
+
+	/* Drop any stale reply so we match THIS request. */
+	while (mpi_fetchMessage(reply_mbox, &rmsg) == 0)
+		;
+
+	/* authd's mailbox may still be coming up. */
+	for (waited = 0; waited < 2000; waited++) {
+		if (mpi_postMessage(AUTHD_MBOX, AUTHD_MSG_REQUEST, &msg) == 0)
+			break;
+		sched_yield();
+		if (waited == 1999)
+			return 0;
+	}
+
+	/* Block (~5 s cap) for the verdict. */
+	for (waited = 0; waited < 50; waited++) {
+		if (mpi_waitMessage(reply_mbox, &rmsg, 10) == 0 &&
+		    rmsg.header == AUTHD_MSG_RESPONSE) {
+			memcpy(&resp, rmsg.data, sizeof(resp));
+			return resp.ok ? 1 : 0;
+		}
+	}
+	return 0;
+}
