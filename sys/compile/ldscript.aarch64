/* AArch64 kernel linker script (QEMU `virt`).
 *
 * `-kernel <ELF>` loads segments at their physical (LMA) addresses and jumps to
 * the ELF entry.  QEMU `virt` RAM starts at 0x40000000, but QEMU also stages its
 * own boot shim there — the shim that loads x0 with the DTB pointer before
 * entering the kernel.  Linking at the RAM base overwrites that shim, so we link
 * 2 MB up (the arm64 text_offset convention); the skipped 0x40000000..0x40200000
 * window stays reserved by the page allocator.
 *
 * HIGHER-HALF MIGRATION (docs/design/aarch64-higher-half-plan.md): the kernel is
 * built to EXECUTE at high VAs (VMA = KERNEL_PHYS + VIRT_OFFSET, reached through
 * the TTBR1 physmap) while LOADED at KERNEL_PHYS (LMA, via AT()).  The `.text.boot`
 * stub stays low (VMA == LMA) so QEMU's entry and the MMU-off early boot are
 * position-correct; it enables the MMU and branches to the high VMA, after which
 * everything runs high.  `VIRT_OFFSET = 0` builds a conventional all-low kernel
 * (migration Phase 2a: verify the boot restructure before flipping to high). */
OUTPUT_FORMAT("elf64-littleaarch64")
OUTPUT_ARCH(aarch64)
ENTRY(_start)

VIRT_OFFSET = 0xFFFFFF8000000000;
/* Physical load address (LMA).  QEMU virt = 0x40200000 (RAM @0x40000000 + the 2 MB
 * boot-shim window).  The Raspberry Pi build overrides this to 0x80000 (where the
 * VideoCore firmware loads kernel8.img) via `--defsym KERNEL_PHYS=0x80000`. */
KERNEL_PHYS = DEFINED(KERNEL_PHYS) ? KERNEL_PHYS : 0x40200000;

SECTIONS
{
	. = KERNEL_PHYS;

	/* Low boot stub: VMA == LMA == KERNEL_PHYS.  Runs with the MMU off, then
	 * enables it and branches to the high half (.text below).  The entry section
	 * (.text.boot.entry, kern/start.S) is placed FIRST so _start is at byte 0 of the
	 * image — required by the Pi's flat kernel8.img (entered at its first byte). */
	.text.boot : { KEEP(*(.text.boot.entry)) *(.text.boot) }

	/* Everything else executes at the high VMA and loads right after the stub
	 * (LMA = VMA - VIRT_OFFSET). */
	. = . + VIRT_OFFSET;

	.text : AT(ADDR(.text) - VIRT_OFFSET) {
		*(.text*)
	}

	.rodata : AT(ADDR(.rodata) - VIRT_OFFSET) { *(.rodata*) }
	.data   : AT(ADDR(.data) - VIRT_OFFSET) { *(.data*) }

	. = ALIGN(16);
	__bss_start = .;
	.bss : AT(ADDR(.bss) - VIRT_OFFSET) {
		*(.bss*)
		*(COMMON)
	}
	. = ALIGN(16);
	__bss_end = .;

	/* Boot stack; _stack_top is the initial SP (grows down toward __bss_end).
	 * 64 KB: the kernel runs the UbixFS lite-ZFS core on this stack, whose
	 * block-tree traversal nests several 4 KB frames — 16 KB overflowed past
	 * __bss_end and corrupted the adjacent page-allocator globals. */
	. = ALIGN(16);
	. += 0x10000;
	_stack_top = .;

	/* End of the kernel image, page-aligned: the physical page bitmap
	 * (vmm_mem_map_init) is staged here.  Matches i386's extern _end[]. */
	. = ALIGN(0x1000);
	_end = .;

	/DISCARD/ : { *(.comment) *(.note*) *(.eh_frame*) }
}
