/* AArch64 bring-up linker script (QEMU `virt`).
 *
 * `-kernel <ELF>` loads segments at their physical addresses and jumps to the
 * ELF entry.  QEMU `virt` RAM starts at 0x40000000, but QEMU also stages its own
 * boot shim there — the shim that loads x0 with the DTB pointer before entering
 * the kernel.  Linking the kernel at the RAM base overwrites that shim, so QEMU
 * skips it and we enter with x0 = 0 (no DTB).  Link 2 MB up (the arm64
 * text_offset convention) so the shim survives and hands us x0 = DTB; the
 * skipped 0x40000000..0x40200000 window stays reserved by the page allocator. */
OUTPUT_FORMAT("elf64-littleaarch64")
OUTPUT_ARCH(aarch64)
ENTRY(_start)

SECTIONS
{
	. = 0x40200000;

	/* .text.boot (the _start entry) must come first so the ELF entry lands
	 * at the load address. */
	.text : {
		*(.text.boot)
		*(.text*)
	}

	.rodata : { *(.rodata*) }
	.data   : { *(.data*) }

	. = ALIGN(16);
	__bss_start = .;
	.bss : {
		*(.bss*)
		*(COMMON)
	}
	. = ALIGN(16);
	__bss_end = .;

	/* Boot stack; _stack_top is the initial SP (grows down toward __bss_end).
	 * 64 KB, not 16 KB: the kernel runs a real filesystem (the UbixFS lite-ZFS
	 * core) on this stack, and its block-tree traversal nests several 4 KB
	 * `block[BS]` frames — 16 KB overflowed past __bss_end and corrupted the
	 * adjacent page-allocator globals (vmmMemoryMap/numPages). */
	. = ALIGN(16);
	. += 0x10000;
	_stack_top = .;

	/* End of the kernel image, page-aligned: the physical page bitmap
	 * (vmm_mem_map_init) is staged here.  Matches i386's extern _end[]. */
	. = ALIGN(0x1000);
	_end = .;

	/DISCARD/ : { *(.comment) *(.note*) *(.eh_frame*) }
}
