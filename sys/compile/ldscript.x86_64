/* x86-64 higher-half linker script.
 *
 * QEMU's PVH loader enters the kernel in 32-bit protected mode at its PHYSICAL
 * load address (the PT_LOAD LMA) — we load at 1 MB (0x100000), above the BIOS/VGA
 * hole.  The kernel is LINKED at the higher half (KERNBASE + 1 MB) so user space
 * owns the entire low canonical half (standard amd64 layout); each section's LMA
 * is its VMA - KERNBASE so it physically lands at 0x100000+.  start.S's 32-bit
 * stub references symbols by physical address (sym - KERNBASE) until paging is on,
 * maps both the low identity range and the kernel high, then jumps to the high VMA.
 *
 * The PVH note's PHYS32_ENTRY must be the PHYSICAL entry (_start - KERNBASE).
 */
OUTPUT_FORMAT("elf64-x86-64")
OUTPUT_ARCH(i386:x86-64)
ENTRY(_start)

KERNBASE = 0xFFFFFFFF80000000;

SECTIONS
{
	. = KERNBASE + 0x100000;

	/* PVH boot note must be present + allocated so QEMU's ELF loader finds it. */
	.note.Xen : AT(ADDR(.note.Xen) - KERNBASE) { *(.note.Xen) }

	.text : AT(ADDR(.text) - KERNBASE) {
		*(.text.boot)
		*(.text*)
	}

	.rodata : AT(ADDR(.rodata) - KERNBASE) { *(.rodata*) }
	.data   : AT(ADDR(.data) - KERNBASE) { *(.data*) }

	. = ALIGN(16);
	__bss_start = .;
	.bss : AT(ADDR(.bss) - KERNBASE) {
		*(.bss*)
		*(COMMON)
	}
	. = ALIGN(16);
	__bss_end = .;

	/* Boot stack; _stack_top is the initial SP (grows down toward __bss_end). */
	. = ALIGN(16);
	. += 0x10000; /* 64 KB */
	_stack_top = .;

	. = ALIGN(0x1000);
	_end = .;

	/DISCARD/ : { *(.comment) *(.eh_frame*) }
}
